{
  // Environnement de developpement : Python 3.12, make et Docker pour le lab.
  // La passerelle lancee ici sert au developpement et au lab, pas au trafic Copilot de l'hote.
  "name": "copilot-pii-gateway",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerEnv": {
    // venv hors du dossier monte, pour ne pas melanger binaires Linux et macOS.
    "VENV": "/home/vscode/.venvs/copilot-pii"
  },
  "postCreateCommand": "make setup",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/copilot-pii/bin/python"
      }
    }
  }
}
